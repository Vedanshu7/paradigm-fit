{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // vitest.config.ts is left out: Vitest 3 bundles older Vite types that do not
  // accept @vitejs/plugin-vue 6 (built for Vite 8), so it fails to type-check
  // for reasons unrelated to this project. Vitest still validates it at run time.
  "include": ["vite.config.ts", "playwright.config.ts"]
}
